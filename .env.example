WHATSAPP_VERIFY_TOKEN="change-me"

# Local PostgreSQL (default dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apps_marketing"

# Supabase PostgreSQL (staging/remote example)
# Use pooled URL for runtime app traffic when needed.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
#
# Optional direct connection (recommended for Prisma migrate/introspection in Supabase)
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

NEXT_PUBLIC_API_BASE_URL=""
PUBLIC_API_ALLOWED_ORIGINS=""
INTERNAL_DASHBOARD_PASSWORD="change-me"
INTERNAL_AUTH_COOKIE_NAME="apps_marketing_internal_auth"
LOCAL_PG_CONTAINER="apps-marketing-postgres"
LOCAL_BACKUP_RETENTION_COUNT="15"

# Public chat AI provider (remote API)
ENABLE_GEMINI_PUBLIC_CHAT="false"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Safe fallback guard for public chat when provider is unavailable
LEAD_AGENT_FALLBACK_ENABLED="true"
