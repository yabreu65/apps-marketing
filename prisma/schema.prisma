generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id              String                    @id @default(cuid())
  name            String
  email           String?
  phone           String?
  businessType    String?
  serviceInterest String
  message         String
  source          String
  status          String                    @default("new")
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  notes           LeadNote[]
  statusHistory   LeadStatusHistory[]
  conversations   LeadConversationMessage[]
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadStatusHistory {
  id         String   @id @default(cuid())
  leadId     String
  fromStatus String?
  toStatus   String
  createdAt  DateTime @default(now())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadConversationMessage {
  id        String   @id @default(cuid())
  leadId    String
  channel   String   @default("whatsapp_simulated")
  direction String
  content   String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}
